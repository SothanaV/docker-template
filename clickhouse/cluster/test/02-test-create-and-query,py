import clickhouse_connect
from datetime import datetime, timedelta
import random

CLUSTER = "my_cluster"

ck = clickhouse_connect.create_client(
    dsn="clickhouse://admin:SuperSecretPassword123!@localhost:8123/default"
)

# ── 1. Create table on cluster ────────────────────────────────────────────────

print(f"{'='*10} CREATE TABLE {'='*10}")

ck.command(f"""
    CREATE TABLE IF NOT EXISTS orders ON CLUSTER {CLUSTER}
    (
        order_id   UInt64,
        user_id    UInt32,
        product    String,
        amount     Float32,
        status     Enum8('pending'=1, 'paid'=2, 'shipped'=3, 'cancelled'=4),
        created_at DateTime
    )
    ENGINE = ReplicatedMergeTree('/clickhouse/tables/{{shard}}/orders', '{{replica}}')
    PARTITION BY toYYYYMM(created_at)
    ORDER BY (created_at, order_id)
""")

print("Table 'orders' created on all nodes.")

# ── 2. Insert mockup data ─────────────────────────────────────────────────────

print(f"\n{'='*10} INSERT MOCKUP DATA {'='*10}")

products = ["Laptop", "Phone", "Tablet", "Monitor", "Keyboard", "Mouse", "Headset"]
statuses = ["pending", "paid", "shipped", "cancelled"]
base_time = datetime(2026, 1, 1)

rows = [
    (
        i,
        random.randint(1, 50),
        random.choice(products),
        round(random.uniform(10.0, 2000.0), 2),
        random.choice(statuses),
        base_time + timedelta(days=random.randint(0, 111), hours=random.randint(0, 23)),
    )
    for i in range(1, 101)
]

ck.insert(
    "orders",
    rows,
    column_names=["order_id", "user_id", "product", "amount", "status", "created_at"],
)

print(f"Inserted {len(rows)} rows.")

# ── 3. Query ──────────────────────────────────────────────────────────────────

print(f"\n{'='*10} TOTAL ROW COUNT (all nodes) {'='*10}")
print(ck.query_df("SELECT count() AS total FROM orders"))

print(f"\n{'='*10} ROWS PER NODE {'='*10}")
print(ck.query_df("""
    SELECT
        hostName()  AS node,
        count()     AS row_count
    FROM clusterAllReplicas('default', default.orders)
    GROUP BY node
    ORDER BY node
"""))

print(f"\n{'='*10} SALES SUMMARY BY PRODUCT {'='*10}")
print(ck.query_df("""
    SELECT
        product,
        count()             AS orders,
        round(sum(amount))  AS total_revenue,
        round(avg(amount))  AS avg_order_value
    FROM orders
    GROUP BY product
    ORDER BY total_revenue DESC
"""))

print(f"\n{'='*10} STATUS BREAKDOWN {'='*10}")
print(ck.query_df("""
    SELECT
        status,
        count()                                       AS count,
        round(count() * 100.0 / sum(count()) OVER()) AS pct
    FROM orders
    GROUP BY status
    ORDER BY count DESC
"""))

print(f"\n{'='*10} SAMPLE ROWS {'='*10}")
print(ck.query_df("""
    SELECT *
    FROM orders
    ORDER BY created_at DESC
    LIMIT 10
"""))
