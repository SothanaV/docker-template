# Project Configuration
PROJECT_NAME='litellm'

# PostgreSQL Database
POSTGRES_DB='litellm'
POSTGRES_MULTIPLE_DATABASES=litellm
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='change-me-to-a-strong-password'
POSTGRES_PORT=5432

# Database URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PROJECT_NAME}-db:${POSTGRES_PORT}/litellm"

# LiteLLM Settings
ENABLE_SIGNUP=true
ENABLE_LOGIN_FORM=true
STORE_MODEL_IN_DB=True
LITELLM_MASTER_KEY='change-me-to-your-master-key'