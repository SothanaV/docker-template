# ==========================================
# n8n Environment Variables
# ==========================================

# Timezone (e.g., Asia/Bangkok, UTC, America/New_York)
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# Domain and URL Setup
# The top level domain to serve n8n from
DOMAIN_NAME=localhost
# The subdomain to serve n8n from
SUBDOMAIN=n8n
# Set this to https if you are using a reverse proxy with SSL
N8N_PROTOCOL=http
# The port n8n will be accessible on internally
N8N_PORT=5678
# The webhook URL (Crucial for external triggers)
WEBHOOK_URL=${N8N_PROTOCOL}://${DOMAIN_NAME}:${N8N_PORT}/

# ==========================================
# Database Credentials (PostgreSQL)
# ==========================================
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=change_this_to_a_secure_password

# Instruct n8n to use Postgres
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=${POSTGRES_DB}
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=${POSTGRES_USER}
DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}

EXTERNAL_HOOK_FILES=/home/node/.n8n/hooks.js
OIDC_ISSUER_URL=https://oauth-prd-ins.xxx.com/.well-known/openid-configuration
OIDC_CLIENT_ID=cPRi6S4zfB80I8JzdXVedyTxVHtIMJ2WXmiSJT8v
OIDC_CLIENT_SECRET=fbvmAY4AJ4YOJ47L8qJaKLwvvGOqfjg9yVZHCI9nBbcqerlE4qSkdStYc3uosz6qRfdpSQfcRbrgYf2B5UdsXj81DeSsw9ex2eDcyPbrlEnHjtfdaOE9rCyWIJV0ESDO
OIDC_REDIRECT_URI=http://localhost:5678/auth/oidc/callback
N8N_ADDITIONAL_NON_UI_ROUTES=auth
EXTERNAL_FRONTEND_HOOKS_URLS=/assets/oidc-frontend-hook.js
NODE_TLS_REJECT_UNAUTHORIZED=0
OIDC_NAME=MOMA