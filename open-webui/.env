PROJECT_NAME=chatui
COMPOSE_PROJECT_NAME=${PROJECT_NAME}
POSTGRES_DB=chatui
POSTGRES_USER=chatui
POSTGRES_PASSWORD=
POSTGRES_HOST=${PROJECT_NAME}-db
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data

QDRANT__SERVICE__API_KEY=
QDRANT__LOG_LEVEL=INFO

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

QDRANT_URI=http://qdrant:6333
QDRANT_API_KEY=
VECTOR_DB=qdrant

# Ollama — set to http://ollama:11434 if using Ollama locally
OLLAMA_BASE_URL=

# OIDC / OAuth
OPENID_PROVIDER_URL=
ENABLE_SIGNUP=false
ENABLE_OAUTH_SIGNUP=true
ENABLE_LOGIN_FORM=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_PROVIDER_NAME=dsm
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=openid email profile
OAUTH_USERNAME_CLAIM=username

# Role sync with OAuth groups
OAUTH_GROUP_CLAIM=roles
OAUTH_GROUP_DEFAULT_SHARE=members
ENABLE_OAUTH_GROUP_MANAGEMENT=true
DEFAULT_USER_ROLE=user

# HA / Multi-instance (optional — requires external Redis)
WEBUI_SECRET_KEY=qwer1234
REDIS_URL=redis://redis:6379/0
WEBSOCKET_REDIS_URL=redis://redis:6379/0
WEBSOCKET_MANAGER=redis

UVICORN_WORKERS=8

# Debug
# HF_HUB_OFFLINE=1
